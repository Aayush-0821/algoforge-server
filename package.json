{
  "name": "algoforge-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch src/server.ts",
    "db:generate": "prisma generate --schema=prisma/postgres/schema.prisma && prisma generate --schema=prisma/mongodb/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/postgres/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "db:reset": "prisma migrate reset --schema=prisma/postgres/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/postgres/schema.prisma",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "npm run type-check",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlgoForgeV1/algoforge-server.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AlgoForgeV1/algoforge-server/issues"
  },
  "homepage": "https://github.com/AlgoForgeV1/algoforge-server#readme",
  "dependencies": {
    "@aayush0821/commit-ai": "^1.0.0",
    "@prisma/client": "^6.16.3",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.45.1",
    "chalk": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jose": "^6.2.5",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.5",
    "ora": "^9.4.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.16.3",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "execa": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "4.20",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
